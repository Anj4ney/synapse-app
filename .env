DATABASE_URL=sqlite:///./synapse.db
JWT_SECRET=replace-with-a-long-random-secret

# Up to 3 separate Gemini API projects for automatic quota failover.
# At least GEMINI_API_KEY_1 is required; _2 and _3 are optional.
GEMINI_API_KEY_1=your_first_project_key
GEMINI_API_KEY_2=your_second_project_key
GEMINI_API_KEY_3=your_third_project_key
GEMINI_MODEL=gemini-3.6-flash

# Optional: seconds a project is skipped after hitting a quota/rate-limit
# error before it's tried again. Defaults to 60 if unset.
GEMINI_QUOTA_COOLDOWN_SECONDS=60

ALLOWED_ORIGINS=*
# Optional: enables the most reliable blog-link lookup (free tier at
# https://brave.com/search/api/). Without it, DuckDuckGo/Bing scraping is
# still tried first and works in most cases.
BRAVE_API_KEY=
